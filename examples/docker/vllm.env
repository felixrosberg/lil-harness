# Point the agent at the vLLM service: docker compose --env-file vllm.env run --rm agent
# If you change VLLM_MODEL, change LIL_MODEL to the same name: vLLM serves the model
# under its Hugging Face name.
VLLM_MODEL=Qwen/Qwen3-4B-AWQ
VLLM_TOOL_PARSER=hermes
LIL_BASE_URL=http://vllm:8000/v1
LIL_MODEL=Qwen/Qwen3-4B-AWQ
